FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["frontend/ContosoRssReader.UI/ContosoRssReader.UI.csproj", "frontend/ContosoRssReader.UI/"]
RUN dotnet restore "frontend/ContosoRssReader.UI/ContosoRssReader.UI.csproj"
COPY . .
WORKDIR "/src/frontend/ContosoRssReader.UI"
RUN dotnet publish "ContosoRssReader.UI.csproj" -c Release -o /app/publish

FROM nginx:alpine AS final
WORKDIR /usr/share/nginx/html
RUN rm -rf ./*
COPY --from=build /app/publish/wwwroot .
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
