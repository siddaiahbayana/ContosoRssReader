FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["backend/ContosoRssReader.Api/ContosoRssReader.Api.csproj", "backend/ContosoRssReader.Api/"]
RUN dotnet restore "backend/ContosoRssReader.Api/ContosoRssReader.Api.csproj"
COPY . .
WORKDIR "/src/backend/ContosoRssReader.Api"
RUN dotnet publish "ContosoRssReader.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "ContosoRssReader.Api.dll"]
